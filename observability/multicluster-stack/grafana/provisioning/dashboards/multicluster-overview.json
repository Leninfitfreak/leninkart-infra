{
  "id": null,
  "uid": "multi-cluster-observer",
  "title": "Multi-Cluster Observer Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(observer_agent_metric_samples_total, cluster_id)",
        "refresh": 1,
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Metric Samples Accepted",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "expr": "sum by (cluster_id) (rate(observer_agent_metric_samples_total{cluster_id=~\"$cluster\"}[5m]))",
          "legendFormat": "{{cluster_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Log Records Accepted",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "expr": "sum by (cluster_id) (rate(observer_agent_log_records_total{cluster_id=~\"$cluster\"}[5m]))",
          "legendFormat": "{{cluster_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Trace Records Accepted",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "expr": "sum by (cluster_id) (rate(observer_agent_trace_records_total{cluster_id=~\"$cluster\"}[5m]))",
          "legendFormat": "{{cluster_id}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Latest Agent Metric Values",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "expr": "observer_agent_latest_metric_value{cluster_id=~\"$cluster\"}",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
